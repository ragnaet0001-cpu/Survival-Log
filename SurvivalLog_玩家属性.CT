  </CheatEntries>
  <LuaScript>
-- ============================================================
-- SurvivalLog 修改器 v5.0 (Mono/IL2CPP)
-- 功能: 玩家属性(饱腹/心态/精力/生命) + 金币 + 灾变倒计时
-- 倒计时UI是WebView(JS): 必须调 R3 ReactiveProperty.set_Value 推送
-- 条目8=当前显示值(改=单次推送); 条目102=锁定目标; 条目101=锁定开关
-- 注意: 加载后等 [定位] 全部成功 再编辑条目! 否则地址为0会访问违规
-- ============================================================

LOCATE_DONE = false
LOCATE_TRIES = 0
CT_DATA = { dsRP = nil, dpsRP = nil, lastSyncedDS = nil, lockCell = nil }

function GetDomains()
  local ok, domains = pcall(mono_enumDomains)
  if ok and type(domains) == "table" and #domains &gt; 0 then return domains end
  pcall(LaunchMonoDataCollector)
  local ok2, d2 = pcall(mono_enumDomains)
  if ok2 and type(d2) == "table" and #d2 &gt; 0 then return d2 end
  return nil
end

function GetHotUpdateImage()
  if getOpenedProcessID() == 0 then return nil end
  local domains = GetDomains()
  if not domains then return nil end
  local asms = mono_enumAssemblies(domains[1])
  for i, a in ipairs(asms) do
    local im = mono_getImageFromAssembly(a)
    if im and mono_image_get_name(im) == "HotUpdate.dll" then return im end
  end
  return nil
end

function FindClassByName(img, name, ns)
  local classes = mono_image_enumClasses(img)
  for i, c in ipairs(classes) do
    if c.classname == name and (ns == nil or c.namespace == ns) then return c end
  end
  if ns ~= nil then
    for i, c in ipairs(classes) do
      if c.classname == name then return c end
    end
  end
  return nil
end

-- 正确签名: mono_class_findInstancesOfClassListOnly(domain, klass)
function FindInstances(klass)
  local domains = GetDomains()
  if not domains then return nil end
  local ok, insts = pcall(mono_class_findInstancesOfClassListOnly, domains[1], klass)
  if ok and type(insts) == "table" then return insts end
  return nil
end

function RelocatePlayerAttrs()
  local img = GetHotUpdateImage()
  if not img then return false, "no image" end
  local ac = FindClassByName(img, "AttributeComponent", "GameCore.HotUpdate.Battle.Logic")
  local attrCls = FindClassByName(img, "Attr", "GameCore.HotUpdate.Battle.Logic")
  if not ac or not attrCls then return false, "attr class not found" end
  local ATTR_TI = attrCls.class
  local insts = FindInstances(ac.class)
  if not insts then return false, "attr no instances" end
  local result = nil
  for _, inst in ipairs(insts) do
    if inst and inst % 8 == 0 and readQword(inst + 8) == 0 then
      local dict = readQword(inst + 0x48)
      if dict and dict ~= 0 then
        local count = readInteger(dict + 0x20)
        local entries = readQword(dict + 0x18)
        if count and count &gt; 0 and count &lt; 500 and entries and entries ~= 0 then
          local found = {}
          local s = entries + 0x18
          local e = entries + 0x18 + count * 48
          for p = s, e, 4 do
            local k = readInteger(p)
            if k and k &gt;= 1 and k &lt;= 5 then
              local v = readQword(p + 8)
              if v and v ~= 0 and v % 8 == 0 and readQword(v) == ATTR_TI then
                found[k] = v
              end
            end
          end
          if found[1] and found[2] and found[3] and found[5] then
            result = { comp = inst, dict = dict, attrs = found }
            break
          end
        end
      end
    end
  end
  if not result then return false, "attr dict parse fail" end
  local al = getAddressList()
  local defs = {
    { id = 1, attr = result.attrs[1] },
    { id = 2, attr = result.attrs[2] },
    { id = 3, attr = result.attrs[3] },
    { id = 4, attr = result.attrs[5] },
    { id = 5, attr = result.attrs[4] },
  }
  for _, d in ipairs(defs) do
    local mr = al.getMemoryRecordByID(d.id)
    if mr then mr.Address = d.attr + 0x10 end
  end
  local mr6 = al.getMemoryRecordByID(6)
  if mr6 then mr6.Address = result.comp end
  return true
end

function RelocateGold()
  local img = GetHotUpdateImage()
  if not img then return false, "no image" end
  local sp = FindClassByName(img, "State_Data_Player", "GameCore.HotUpdate.ReduxUI")
  if not sp then return false, "State_Data_Player not found" end
  local insts = FindInstances(sp.class)
  if not insts then return false, "player no instances" end
  local best = nil
  for _, inst in ipairs(insts) do
    if inst and inst % 8 == 0 and readQword(inst + 8) == 0 then
      local gold = readInteger(inst + 0x2C)
      if gold and gold &gt; 0 then
        if not best or gold &gt; best.gold then
          best = { inst = inst, gold = gold }
        end
      end
    end
  end
  if not best then return false, "no gold instance" end
  local mr = getAddressList().getMemoryRecordByID(7)
  if mr then mr.Address = best.inst + 0x2C end
  return true
end

function RelocateCountdown()
  local img = GetHotUpdateImage()
  if not img then return false, "no image" end
  local ct = FindClassByName(img, "State_Web_CoreUI0", "GameCore.HotUpdate.ReduxUI")
  if not ct then return false, "State_Web_CoreUI0 not found" end
  local insts = FindInstances(ct.class)
  if not insts then return false, "coreui no instances" end
  local best = nil
  for _, inst in ipairs(insts) do
    if inst and inst % 8 == 0 and readQword(inst + 8) == 0 then
      local dsRP = readQword(inst + 0x38)
      if dsRP and dsRP ~= 0 then
        local dv = readFloat(dsRP + 0x20)
        if dv and dv &gt; 0 and dv &lt; 1000000 then
          if not best or dv &gt; best.dv then
            best = { inst = inst, dsRP = dsRP, dv = dv }
          end
        end
      end
    end
  end
  if not best then return false, "no active coreui instance" end
  CT_DATA.dsRP = best.dsRP
  CT_DATA.dpsRP = readQword(best.inst + 0x40)
  CT_DATA.lastSyncedDS = nil
  local al = getAddressList()
  local mr8 = al.getMemoryRecordByID(8)
  if mr8 then mr8.Address = best.dsRP + 0x20 end
  if CT_DATA.dpsRP and CT_DATA.dpsRP ~= 0 then
    local mr9 = al.getMemoryRecordByID(9)
    if mr9 then mr9.Address = CT_DATA.dpsRP + 0x20 end
  end
  -- 定位真源: GameTimeManager -> CountDownTimer (RemainTime x5 = 显示秒)
  CT_DATA.cdt = nil
  local gtmCls = FindClassByName(img, "GameTimeManager", "GameCore.HotUpdate.Battle.Logic")
  if gtmCls then
    local gInsts = FindInstances(gtmCls.class)
    if gInsts then
      for _, gInst in ipairs(gInsts) do
        if gInst and gInst % 8 == 0 and readQword(gInst + 8) == 0 then
          local timer = readQword(gInst + 0x38)
          local ws = readInteger(gInst + 0x64)
          if timer and timer ~= 0 and ws and (ws == 0 or ws == 1 or ws == 2) then
            local h = string.format("%X", timer)
            if h:sub(1, 4) ~= "7FF8" and h:sub(1, 4) ~= "7FFF" and timer > 0x100000 then
              CT_DATA.cdt = timer
              break
            end
          end
        end
      end
    end
  end
  if CT_DATA.cdt then
    local mr103 = al.getMemoryRecordByID(103)
    if mr103 then mr103.Address = CT_DATA.cdt + 0x10 end
    local remain = readFloat(CT_DATA.cdt + 0x10) or 0
    print(string.format("[定位] 倒计时源: RemainTime=%.1f (显示=%.0fs=%.2f小时)", remain, remain * 5, remain * 5 / 3600))
  else
    print("[定位] 倒计时源(CDT)未找到, 仅显示层可用")
  end
  print(string.format("[定位] 灾变倒计时: DisplaySeconds=%.0fs (%.2f小时)", best.dv, best.dv / 3600))
  return true
end

-- 冻结/解冻: DecreasePerSecond 置 0 或 5
function FreezeCountdown(freeze)
  if not CT_DATA.dpsRP then return false end
  local v = freeze and 0 or 5
  local ok1, cls = pcall(mono_object_getClass, CT_DATA.dpsRP)
  if not ok1 or not cls then return false end
  local ok2, m = pcall(mono_class_findMethod, cls, "set_Value")
  if not ok2 or not m then return false end
  local domains = GetDomains()
  if not domains then return false end
  local ok3 = pcall(mono_invoke_method, domains[1], m, CT_DATA.dpsRP, {{type=vtSingle, value=v}})
  if ok3 then
    print(string.format("[冻结] DecreasePerSecond -> %d (%s)", v, freeze and "倒计时已冻结" or "倒计时恢复正常"))
  end
  return ok3
end

-- 通过 R3 ReactiveProperty.set_Value 推送新值给 WebView(JS)
function PushCountdown(value)
  if not CT_DATA.dsRP then return false end
  local ok1, cls = pcall(mono_object_getClass, CT_DATA.dsRP)
  if not ok1 or not cls then return false end
  local ok2, m = pcall(mono_class_findMethod, cls, "set_Value")
  if not ok2 or not m then return false end
  local domains = GetDomains()
  if not domains then return false end
  local ok3, res = pcall(mono_invoke_method, domains[1], m, CT_DATA.dsRP, {{type=vtSingle, value=value}})
  return ok3
end

-- 确保锁定目标单元格存在(进程内分配, 条目102指向它)
function EnsureLockCell()
  if CT_DATA.lockCell then return true end
  CT_DATA.lockCell = allocateMemory(8)
  if not CT_DATA.lockCell then return false end
  writeFloat(CT_DATA.lockCell, 36000)
  local mr = getAddressList().getMemoryRecordByID(102)
  if mr then mr.Address = CT_DATA.lockCell end
  return true
end

function RelocateAll()
  if getOpenedProcessID() == 0 then return false, "no process" end
  EnsureLockCell()
  local c, cerr = RelocateCountdown()
  if c then print("[定位] 倒计时 OK") else print("[定位] 倒计时失败: " .. tostring(cerr)) end
  local g, gerr = RelocateGold()
  if g then print("[定位] 金币 OK") else print("[定位] 金币失败: " .. tostring(gerr)) end
  local a, aerr = RelocatePlayerAttrs()
  if a then print("[定位] 属性 OK") else print("[定位] 属性失败: " .. tostring(aerr)) end
  if c and g and a then
    LOCATE_DONE = true
    print("[定位] 全部成功! 现在可以编辑条目了")
    return true
  end
  return false
end

-- 定位监视: 每 4 秒重试, 最多 15 次(约60秒), 然后给出指引
local lastPID = 0
local retryTimer = createTimer(nil, false)
retryTimer.Interval = 4000
retryTimer.OnTimer = function(timer)
  local pid = getOpenedProcessID()
  if pid == 0 then
    if LOCATE_TRIES % 5 == 0 then print("[定位] 等待附加进程... (请附加 SurvivalLog.exe)") end
    return
  end
  if LOCATE_DONE and pid == lastPID then return end
  lastPID = pid
  LOCATE_TRIES = LOCATE_TRIES + 1
  if RelocateAll() then
    LOCATE_DONE = true
  elseif LOCATE_TRIES &gt;= 15 then
    timer.destroy()
    print("[定位] 15次尝试失败: 请确认 1.已附加进程 2.Mono功能已激活(菜单 Mono->Activate mono features) 3.游戏在主界面")
  end
end
retryTimer.Enabled = true

-- 同步监视: 修改条目8(当前显示值)后自动单次推送
local syncTimer = createTimer(nil, false)
syncTimer.Interval = 500
syncTimer.OnTimer = function(timer)
  if not LOCATE_DONE or not CT_DATA.dsRP then return end
  local mr = getAddressList().getMemoryRecordByID(8)
  if not mr then return end
  local nv = tonumber(mr.Value)
  if nv == nil then return end
  if CT_DATA.lastSyncedDS == nil then
    CT_DATA.lastSyncedDS = nv
    return
  end
  if nv ~= CT_DATA.lastSyncedDS then
    if PushCountdown(nv) then
      CT_DATA.lastSyncedDS = nv
      print(string.format("[倒计时] 已推送: %.0f 秒 (%.2f 小时)", nv, nv / 3600))
    end
  end
end
syncTimer.Enabled = true

-- 锁定: 勾选[101]后每 0.5 秒推送"锁定目标值"(条目102), 显示钉住
local lockTimer = nil
function StartLock()
  if lockTimer then return end
  if not CT_DATA.lockCell then EnsureLockCell() end
  lockTimer = createTimer(nil, false)
  lockTimer.Interval = 500
  lockTimer.OnTimer = function(t)
    if not LOCATE_DONE or not CT_DATA.dsRP then return end
    if CT_DATA.lockCell then
      local v = readFloat(CT_DATA.lockCell)
      if v and v &gt; 0 then
        PushCountdown(v)
        -- 同时写回源(RemainTime = v/5) 和 冻结(DecreasePerSecond=0)
        if CT_DATA.cdt then writeFloat(CT_DATA.cdt + 0x10, v / 5) end
        if CT_DATA.dpsRP then writeFloat(CT_DATA.dpsRP + 0x20, 0) end
      end
    end
  end
  lockTimer.Enabled = true
  print("[锁定] 倒计时锁定中: 每0.5秒推送+写回源+冻结, 显示钉住不动")
end
function StopLock()
  if lockTimer then
    lockTimer.destroy()
    lockTimer = nil
    print("[锁定] 已解除")
  end
end

print("=== SurvivalLog 修改器 v5.0 ===")
print(string.format("[状态] 已附加进程: %s", tostring(getOpenedProcessID() ~= 0)))
local il2ok, il2 = pcall(mono_isil2cpp)
print("[状态] IL2CPP: " .. tostring(il2ok and il2 or "?"))
print("[提示] 正在自动定位... 等看到 [定位] 全部成功 再编辑条目! (地址为0时编辑会访问违规)")
  </LuaScript>
</CheatTable>
